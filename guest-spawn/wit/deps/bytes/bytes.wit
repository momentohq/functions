package momento:bytes@1.0.0;

interface bytes {
    // Why a buffer's source failed partway through.
    variant stream-error {
        // The call's deadline expired while the body was still arriving.
        timed-out,
        // The source failed for any other reason. The message is safe to log.
        failed(string),
    }

    // for reading from the host
    resource buffer {
        // Get the number of bytes currently ready to be read.
        //
        // `read` can return this many bytes without blocking.
        remaining: func() -> u32;

        // Read up to `max-size` bytes from the body.
        //
        // It is an error to return more than `max-size` bytes.
        //
        // You have no guarantee that you'll get `max-size` bytes,
        // but you will never get an empty list.
        //
        // Returns None if there is no more data.
        read: func(max-size: u32) -> option<list<u8>>;

        // Advance the read cursor by `size` bytes.
        advance: func(size: u32);

        // Like `read`, but a source that fails partway through reports why
        // instead of ending. `read` treats that failure as the end of the data.
        //
        // The bytes received before the failure are returned first; after
        // them, every call returns the same error.
        try-read: func(max-size: u32) -> result<option<list<u8>>, stream-error>;
    }

    // could be bytes or a buffer reference
    variant data {
        // use the remainder of this buffer
        buffer(buffer),
        // use these literal bytes
        value(list<u8>),
    }
}

world imports {
    import bytes;
}
